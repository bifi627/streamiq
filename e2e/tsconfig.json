{
  // #581: typecheck only (Playwright and node strip types). Runs with frontend's tsc: e2e has no typescript of its own
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["*.ts"]
}
